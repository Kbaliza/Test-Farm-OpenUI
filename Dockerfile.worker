# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# WhatsApp worker image.
#
# whatsapp-web.js drives a real Chromium through puppeteer, so this image needs
# a browser and its shared libraries. We install Debian's chromium rather than
# letting puppeteer download its own — the apt build works on both amd64 and
# arm64, and PUPPETEER_EXECUTABLE_PATH points puppeteer at it.
#
# Run exactly ONE replica: LocalAuth takes a lock on the session directory.
# ---------------------------------------------------------------------------

FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium \
      openssl \
      ca-certificates \
      fonts-liberation \
      dumb-init \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    NODE_ENV=production

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
# The worker runs through tsx, so devDependencies are required — no --omit=dev.
RUN npm ci

COPY scripts ./scripts
COPY src/lib/whatsapp.ts ./src/lib/whatsapp.ts
COPY tsconfig.json ./
# Raw SQL applied post-migrate by scripts/deploy.sh, which reuses this image
# because it is the one that carries the prisma CLI and tsx.
COPY supabase ./supabase

# LocalAuth writes here; compose mounts a named volume over it so the paired
# session survives redeploys and you don't re-scan the QR on every push.
RUN mkdir -p .wwebjs_auth && chown -R node:node /app
USER node

# dumb-init reaps the Chromium child processes puppeteer leaves behind.
ENTRYPOINT ["dumb-init", "--"]
CMD ["npx", "tsx", "scripts/whatsapp-worker.ts"]
